# Salin jadi .env.local lalu isi dari Supabase → Project Settings.
# Tanpa nilai ini website & admin tetap jalan dengan data demo.

# Project Settings → API (aman untuk browser; data dilindungi RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk `npm run db:setup` di laptop (Project Settings → Database → Connection string,
# mode "Session pooler"). Berisi password database — JANGAN di-commit / dibagikan.
DATABASE_URL=

# Hanya server (Vercel + .env.local), untuk "Undang anggota" di Settings & Roles.
# Supabase → Project Settings → API Keys → secret / service_role. JANGAN pakai NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL website publik (link daftar di undangan WhatsApp dari admin). Default: https://soslay-web.vercel.app
NEXT_PUBLIC_SITE_URL=
